{
  "name": "subject-core-game",
  "version": "0.1.0",
  "description": "ЯДРО СУБЪЕКТА · ЖИВОЙ ЦИКЛ — стратегическая игра становления на основе ТзАрх.",
  "private": true,
  "license": "MIT",
  "homepage": "https://lacinnik.github.io/Game-GDEYA/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lacinnik/Game-GDEYA.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config public-web/vite.config.ts",
    "build": "vite build --config public-web/vite.config.ts",
    "build:public": "npm run build",
    "preview": "vite preview --config public-web/vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "vendor:check": "node scripts/vendor-sync.mjs --check",
    "vendor:drift": "node scripts/vendor-sync.mjs --drift",
    "vendor:update": "node scripts/vendor-sync.mjs --update",
    "ecosystem:status": "node scripts/ecosystem-status.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:mobile": "npm run build && node tests/e2e/mobile.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "playwright": "1.61.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "ЯДРО СУБЪЕКТА · ЖИВОЙ ЦИКЛ"
}
